meta {
  name: addProviderHolder
  type: http
  seq: 4
}

post {
  url: {{ISSUER_ISS_API}}/v1alpha/participants/{{ISS_PART_CONT}}/holders
  body: json
  auth: inherit
}

body:json {
  {
    "holderId" : "{{PROV_ID}}", 
    "did" : "{{PROV_ID}}",  
    "name" : "{{PROV_PART_CONT}}"
  }
}

script:pre-request {
  req.setHeader("x-api-key", bru.getEnvVar("ISSUER_APIKEY"));
}

settings {
  encodeUrl: true
  timeout: 0
}
