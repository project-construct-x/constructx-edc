meta {
  name: VaultSecret
  type: http
  seq: 4
}

post {
  url: {{PROVIDER_VAULTURL}}/v1/secret/data/providersecret
  body: json
  auth: inherit
}

headers {
  X-Vault-Token: vaultsecret0123456789
  ~X-Vault-Token: <VAULT_TOKEN>
}

body:json {
  {
    "data": {
      "content": "{{PROVIDER_STS_SECRET}}"
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
