meta {
  name: Check Imported Policy
  type: http
  seq: 4
}

get {
  url: {{PROVIDER_MANAGEMENT}}/v4/policydefinitions/{{HUB_POLICY_ID}}
  body: none
  auth: inherit
}

headers {
  X-Api-Key: prov-management-api-key
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}

docs {
  Reads back the policy imported via ImportPolicyFromHub. The import stores the policy under the
  Policy Hub's UUID, which is HUB_POLICY_ID, so no other variable is needed. The response's
  "privateProperties.policyHubName" carries the Policy Hub's human-readable policy name.
}
