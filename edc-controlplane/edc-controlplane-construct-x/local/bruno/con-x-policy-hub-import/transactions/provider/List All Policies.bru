meta {
  name: List All Policies
  type: http
  seq: 6
}

post {
  url: {{PROVIDER_MANAGEMENT}}/v3/policydefinitions/request
  body: json
  auth: inherit
}

headers {
  X-Api-Key: prov-management-api-key
}

body:json {
  {
    "@context": {
      "@vocab": "https://w3id.org/edc/v0.0.1/ns/"
    },
    "@type": "QuerySpec",
    "offset": 0,
    "limit": 50
  }
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}

docs {
  Lists every policy definition stored in the provider connector - imported from the Policy Hub
  via ImportPolicyFromHub as well as hand-written ones (e.g. CreatePolicy's "aPolicy"). Reads the
  connector database only, never the Policy Hub. Imported policies are recognisable by
  "privateProperties.policyHubName". Adjust "offset"/"limit" to paginate or add a
  "filterExpression" to narrow the result.
}
