meta {
  name: RequestProviderCatalog
  type: http
  seq: 1
}

post {
  url: {{CONSUMER_MANAGEMENT}}/v3/catalog/request
  body: json
  auth: inherit
}

body:json {
  {
    "@context": {
      "@vocab": "https://w3id.org/edc/v0.0.1/ns/"
    },
    "counterPartyAddress": "http://provider-controlplane:9020/dsp/2025-1",
    "counterPartyId": "{{PROV_ID}}",
    "protocol": "dataspace-protocol-http:2025-1"
  }
}

script:post-response {
  
    const targetAssetId = bru.getEnvVar("TARGET_ASSET_ID");
    
    var offerId;
    var permissionArray;
    var foundIt = false;
    
    res.getBody().dataset.forEach(dataset => {
      if (dataset['@id'] == targetAssetId) {
        dataset.hasPolicy.forEach(item => {
            const type = item['@type'];
            const id = item['@id'];
            if (type == "Offer" && id != null) {
              offerId = id;
              permissionArray = item.permission;
              foundIt = true;
            }
        });
      }
    });
    if (!foundIt) {
      offerId = "";
      permissionArray = [];
    }
    bru.setEnvVar("offerId", offerId);
    bru.setEnvVar("catalogPermission", JSON.stringify(permissionArray));
}

settings {
  encodeUrl: true
  timeout: 0
}
