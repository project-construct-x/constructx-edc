meta {
  name: CreateContractDefinition
  type: http
  seq: 4
}

post {
  url: {{PROVIDER_MANAGEMENT}}/v3/contractdefinitions
  body: json
  auth: inherit
}

body:json {
  {
    "@context": {
      "@vocab": "https://w3id.org/edc/v0.0.1/ns/"
    },
    "@id": "1",
    "accessPolicyId": "zugriff-konsortium-mitglieder",
    "contractPolicyId": "zugriff-konsortium-mitglieder",
    "assetsSelector": []
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  References the policy imported from the Construct-X Policy Hub via ImportPolicyFromHub
  (id "zugriff-konsortium-mitglieder": ACCESS policy with a Membership constraint that the
  testbed's MembershipCredential satisfies).

  If you are running without the Policy Hub, run CreatePolicy instead and set
  accessPolicyId/contractPolicyId back to "aPolicy".
}
