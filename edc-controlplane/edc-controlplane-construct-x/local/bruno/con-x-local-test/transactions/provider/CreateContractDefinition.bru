meta {
  name: CreateContractDefinition
  type: http
  seq: 5
}

post {
  url: {{PROVIDER_MANAGEMENT}}/v3/contractdefinitions
  body: json
  auth: inherit
}

body:json {
  {
    "@context": {
      "@vocab": "https://w3id.org/edc/v0.0.1/ns/"
    },
    "@id": "1",
    "accessPolicyId": "{{importedPolicyId}}",
    "contractPolicyId": "{{importedPolicyId}}",
    "assetsSelector": []
  }
}

vars:pre-request {
  importedPolicyId: {{HUB_POLICY_ID}}
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  References the policy imported from the Construct-X Policy Hub via ImportPolicyFromHub, whose
  post-response script sets the env var "importedPolicyId" to whatever "@id" the import
  returned - the Policy Hub's UUID. Run ImportPolicyFromHub first (or re-run it after changing
  HUB_POLICY_ID) so this variable points at the policy you actually want the contract
  definition to use - a stale or unset value here means the contract definition silently
  references a non-existent policy and the asset drops out of the catalog (no error, dataset
  just comes back empty). The pre-request default below mirrors HUB_POLICY_ID purely so it
  stays a plausible, UUID-shaped placeholder matching the current import scheme - it still
  requires that policy to have actually been imported first.
  
  If you are running without the Policy Hub, run CreatePolicy instead and set
  accessPolicyId/contractPolicyId to "aPolicy".
}
