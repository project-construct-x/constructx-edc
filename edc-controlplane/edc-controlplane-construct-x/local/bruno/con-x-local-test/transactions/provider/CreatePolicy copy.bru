meta {
  name: CreatePolicy copy
  type: http
  seq: 4
}

post {
  url: {{PROVIDER_MANAGEMENT}}/v3/policydefinitions
  body: json
  auth: inherit
}

body:json {
  {
    "@context": [
      "https://w3id.org/dspace/2025/1/odrl-profile.jsonld",
      {
        "@vocab": "https://w3id.org/edc/v0.0.1/ns/"
      }
    ],
    "@type": "PolicyDefinition",
    "@id": "bPolicy",
    "policy": {
      "@type": "Set",
      "permission": [
        {
          "action": "http://www.w3.org/ns/odrl/2/use",
          "constraint": {
            "and": [
              {
                "leftOperand": "https://w3id.org/constructx/policy/v1.0/ConstructXMembership",
                "operator": "eq",
                "rightOperand": "inactive"
              }
            ]
          }
        }
      ],
      "prohibition": [],
      "obligation": []
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
